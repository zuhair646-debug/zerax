        "en": ["chatgpt", "openai key", "use my openai"]
      },
      "required_credentials": [
        {
          "key": "OPENAI_API_KEY",
          "ar_label": "OpenAI API Key",
          "where_to_get": {
            "ar": "1. platform.openai.com\n2. API Keys → Create new\n3. انسخ sk-...",
            "en": "1. platform.openai.com\n2. API Keys → Create new\n3. Copy sk-..."
          },
          "validation_url": "https://api.openai.com/v1/models",
          "validation_header": "Authorization: Bearer {token}",
          "is_secret": true,
          "format_regex": "^sk-[a-zA-Z0-9_-]{20,}$"
        }
      ],
      "note_ar": "💡 ملاحظة: نحن نوفّر Emergent LLM Key المجاني — لا تحتاج هذا إلا إذا كنت تريد دفع من حسابك الخاص.",
      "note_en": "💡 Note: We provide a free Emergent LLM Key — you only need this if you want to pay from your own account."
    },
