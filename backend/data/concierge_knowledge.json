    "ssh_deploy": {
      "id": "ssh_deploy",
      "ar_label": "نشر مباشر للسيرفر (SSH)",
      "en_label": "Direct Server Deploy (SSH)",
      "category": "deployment",
      "triggers": {
        "ar": ["انشر على السيرفر", "ssh", "vps", "hetzner", "digitalocean", "نشر مباشر", "deploy direct"],
        "en": ["deploy to server", "ssh", "vps", "hetzner", "digitalocean", "deploy direct"]
      },
      "required_credentials": [
        {
          "key": "SSH_HOST",
          "ar_label": "SSH Host (IP أو domain)",
          "en_label": "SSH Host (IP or domain)",
          "where_to_get": {
            "ar": "مثال: 142.93.45.10 أو myserver.com — من لوحة تحكم الـ VPS",
            "en": "Example: 142.93.45.10 or myserver.com — from your VPS dashboard"
          },
          "is_secret": false
        },
        {
          "key": "SSH_USERNAME",
          "ar_label": "اسم المستخدم",
          "en_label": "Username",
          "where_to_get": {
            "ar": "غالباً 'root' أو 'ubuntu' أو 'admin'",
            "en": "Usually 'root', 'ubuntu', or 'admin'"
          },
          "is_secret": false
        },
        {
          "key": "SSH_PASSWORD",
          "ar_label": "كلمة السر (أو استخدم Private Key بدلاً)",
          "en_label": "Password (or use Private Key instead)",
          "where_to_get": {
            "ar": "كلمة السر اللي استخدمتها لما أنشأت السيرفر — أو اتركها فاضية واستخدم Private Key",
            "en": "Password set when you created the VPS — or leave empty and use Private Key"
          },
          "is_secret": true
        }
      ],
      "optional_credentials": [
        {"key": "SSH_PORT", "ar_label": "Port (افتراضي 22)", "needed_for": "Non-standard ports"},
        {"key": "SSH_PRIVATE_KEY", "ar_label": "SSH Private Key (PEM)", "needed_for": "Key-based auth (أكثر أماناً من كلمة السر)"}
      ],
      "cost_to_user": {
        "free_tier": "حسب مزوّد VPS (Hetzner: من $4/شهر، DigitalOcean: من $4/شهر)",
        "paid": "متغيّر"
      },
      "prerequisites_ar": ["سيرفر VPS جاهز (مثل Hetzner أو DigitalOcean أو Linode — تبدأ من $4/شهر)", "صلاحية SSH على المنفذ المطلوب"],
      "prerequisites_en": ["A ready VPS server (e.g. Hetzner, DigitalOcean, or Linode — from $4/month)", "SSH access on the desired port"],
      "common_mistakes_ar": [
        "نسخ المفتاح الخاص بدون السطر -----BEGIN/END----- — لازم تنسخه كاملاً",
        "Firewall يمنع SSH — تأكد أن port 22 مفتوح"
      ],
      "common_mistakes_en": [
        "Copying private key without -----BEGIN/END----- lines — copy the entire file",
        "Firewall blocking SSH — ensure port 22 is open"
      ]
    }
  }
